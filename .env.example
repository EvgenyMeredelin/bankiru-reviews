# ── Auth ────────────────────────────────────────────────────────────────────
API_TOKEN=
LOGFIRE_TOKEN=

# ── Database (Postgres, external) ───────────────────────────────────────────
POSTGRES_URL=postgresql+psycopg://<username>:<password>@<host>/<db>

# ── Object storage (S3-compatible, external) ────────────────────────────────
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
OBS_BUCKET=
OBS_ACCESS_KEY=
OBS_SECRET_KEY=
OBS_REGION=
OBS_ENDPOINT=

# ── API service ─────────────────────────────────────────────────────────────
# NOTE: if you change API_PORT, also update the :1706 in the two endpoint
# URLs below so parser and UI keep reaching the API.
API_PORT=1706

# ── Parser service ──────────────────────────────────────────────────────────
CREATE_REVIEWS_ENDPOINT=http://api:1706/reviews
PARSER_CRON_HOUR=0
PARSER_CRON_MINUTE=5
PARSER_TIMEZONE=Europe/Moscow
# How many past calendar days to collect on each run (default 1 = yesterday).
PARSER_DAYS=1

# Parser pacing — sequential, one request at a time, randomised sleep
PARSER_SLEEP_MIN=10.0
PARSER_SLEEP_MAX=20.0
PARSER_CONNECT_TIMEOUT=5.0
PARSER_READ_TIMEOUT=15.0
PARSER_MAX_RETRIES=5
PARSER_BAN_PAUSE_MAX=300.0

# ── UI service ──────────────────────────────────────────────────────────────
UI_PORT=17060
# Trust X-Forwarded-* from any upstream. The container is bound to
# 127.0.0.1 on the host so any reachable upstream is trusted by design.
# Tighten to specific IPs (e.g. 172.22.0.1) only if you ever publish
# UI_PORT directly to the public internet.
TRUSTED_HOSTS=*
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_MIDDLEWARE_SECRET=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=https://uva-advanced.ru/application/o/bankiru/.well-known/openid-configuration
# Must exactly match the Redirect URI registered in Authentik's OAuth2 provider.
OIDC_REDIRECT_URI=https://bankiru.uva-advanced.ru/auth
# Must exactly match one of Authentik's "Post Logout Redirect URIs".
OIDC_POST_LOGOUT_URI=https://bankiru.uva-advanced.ru/
GET_REVIEWS_URL=http://api:1706/reviews

# ── Summarization (Cloud.ru Foundation Models, OpenAI-compatible) ───────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://foundation-models.api.cloud.ru/v1
DEFAULT_CLOUD_MODEL=anthropic/claude-sonnet-4.6
OUTPUT_TOKENS_LIMIT=50000

# Map-reduce summarizer tuning
DEFAULT_MODEL_CONTEXT=200000
SUMMARIZER_MAP_CONCURRENCY=4
SUMMARIZER_SAFETY_MARGIN_TOKENS=512
SUMMARIZER_MAX_PASSES=4
