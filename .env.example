# ── Environment variable template ───────────────────────────────────────────
# Copy this file to .env and fill in the values for local development.
# In production, scripts/start.sh pulls secrets from Infisical into
# /dev/shm/bankiru-reviews-secrets/.env — this file is only a reference.
#
# All variables here are read by src/bankiru/config.py (Pydantic Settings).
# Variables without defaults in config.py are REQUIRED; the rest are optional.

# ── Auth ────────────────────────────────────────────────────────────────────
# Privileged secret for the API-Token header on POST/DELETE /reviews.
# The parser sends this token when submitting crawled reviews. Also accepted
# for GET /reviews via the public Nginx gateway.
API_TOKEN=
# Comma-separated owner@example.org:token pairs for GET /reviews through
# https://bankiru.uva-advanced.ru. The client sends only the token in
# API-Token, not the owner. Guests cannot POST/DELETE. Leave empty to
# allow only API_TOKEN on the gateway GET path. Tokens must not contain commas.
# Example: GUEST_API_TOKEN=alice@example.org:secret,bob@example.org:other
GUEST_API_TOKEN=
# Logfire write token for observability (optional; omit for local dev).
LOGFIRE_TOKEN=

# ── Database (Postgres, external) ───────────────────────────────────────────
# Full SQLAlchemy async connection URL. The `postgresql+psycopg` scheme
# selects the psycopg3 async driver. Replace placeholders with real values.
POSTGRES_URL=postgresql+psycopg://<username>:<password>@<host>/<db>

# ── Object storage (S3-compatible, external) ────────────────────────────────
# These two AWS_* variables are read directly by aiobotocore (not by
# config.py). They disable checksum validation for non-AWS S3 providers
# like Cloud.ru OBS, which don't support the newer checksum algorithms.
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
# S3 bucket name, credentials, region, and endpoint for Cloud.ru OBS.
# Used by the API to upload exported files and daily Parquet backups.
OBS_BUCKET=
OBS_ACCESS_KEY=
OBS_SECRET_KEY=
OBS_REGION=
OBS_ENDPOINT=
# S3 subfolder for daily Parquet backups (default: bankiru-reviews).
# Files are written as: {prefix}/bankiru-reviews-YYYY-MM-DD.parquet
OBS_BACKUP_PREFIX=bankiru-reviews

# ── API service ─────────────────────────────────────────────────────────────
# Port the FastAPI server listens on inside the container.
# NOTE: if you change API_PORT, also update the :1706 in the two endpoint
# URLs below (CREATE_REVIEWS_ENDPOINT and GET_REVIEWS_URL) so the parser
# and UI can still reach the API over the compose network.
API_PORT=1706

# ── Parser service ──────────────────────────────────────────────────────────
# Internal compose-network URL where the parser POSTs collected reviews.
CREATE_REVIEWS_ENDPOINT=http://api:1706/reviews
# APScheduler cron schedule: hour and minute in PARSER_TIMEZONE when the
# daily crawl fires. Default 00:05 Moscow time = shortly after midnight,
# so yesterday's reviews are available on banki.ru.
PARSER_CRON_HOUR=0
PARSER_CRON_MINUTE=5
PARSER_TIMEZONE=Europe/Moscow
# How many past calendar days to collect on each run (default 1 = yesterday).
# Set to 7 to backfill a week of reviews.
PARSER_DAYS=1

# Parser pacing — sequential, one request at a time, randomised sleep.
# These control how fast the parser hits banki.ru. See README for the
# full timing model and ban-recovery backoff formula.
PARSER_SLEEP_MIN=10.0
PARSER_SLEEP_MAX=20.0
PARSER_CONNECT_TIMEOUT=5.0
PARSER_READ_TIMEOUT=15.0
PARSER_MAX_RETRIES=5
PARSER_BAN_PAUSE_MAX=300.0

# ── UI service ──────────────────────────────────────────────────────────────
# Port the Gradio UI listens on. Bound to 127.0.0.1 on the host (not
# 0.0.0.0) — public access goes through the host's Nginx reverse proxy.
UI_PORT=17060
# Trust X-Forwarded-* from any upstream. The container is bound to
# 127.0.0.1 on the host so any reachable upstream is trusted by design.
# Tighten to specific IPs (e.g. 172.22.0.1) only if you ever publish
# UI_PORT directly to the public internet.
TRUSTED_HOSTS=*
# Signs Starlette session cookies. Must be a strong random string.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_MIDDLEWARE_SECRET=
# Authentik OIDC client credentials. Create an OAuth2/OpenID provider in
# Authentik and copy the Client ID and Client Secret here.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC discovery document URL — Authentik's well-known endpoint for this app.
OIDC_DISCOVERY_URL=https://uva-advanced.ru/application/o/bankiru/.well-known/openid-configuration
# Must exactly match the Redirect URI registered in Authentik's OAuth2 provider.
# This is where Authentik sends the user after successful authentication.
OIDC_REDIRECT_URI=https://bankiru.uva-advanced.ru/auth
# Must exactly match one of Authentik's "Post Logout Redirect URIs".
# This is where the user lands after logging out.
OIDC_POST_LOGOUT_URI=https://bankiru.uva-advanced.ru/
# Internal compose-network URL where the UI fetches reviews from the API.
GET_REVIEWS_URL=http://api:1706/reviews

# ── Summarization (Cloud.ru Foundation Models, OpenAI-compatible) ───────────
# API key and base URL for the LLM provider. Points to Cloud.ru Foundation
# Models by default, but any OpenAI-compatible endpoint works.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://foundation-models.api.cloud.ru/v1
# Default model for the map-reduce summarization pipeline.
DEFAULT_CLOUD_MODEL=anthropic/claude-sonnet-4.6
# Maximum output tokens the model may generate per call.
OUTPUT_TOKENS_LIMIT=50000

# Map-reduce summarizer tuning — controls how large review batches are
# chunked (map phase) and merged (reduce phase).
# Fallback context window size when the /models catalog is unreachable.
DEFAULT_MODEL_CONTEXT=200000
# Maximum concurrent LLM calls during the map pass.
SUMMARIZER_MAP_CONCURRENCY=4
# Token slack subtracted from the input budget each pass to avoid overflow.
SUMMARIZER_SAFETY_MARGIN_TOKENS=512
# Hard ceiling on map-reduce recursion depth.
SUMMARIZER_MAX_PASSES=4

# ── Embeddings (Cloud.ru Foundation Models, OpenAI-compatible) ───────────────
# Separate API key and base URL for the embeddings endpoint.
# If not set, falls back to OPENAI_API_KEY / OPENAI_BASE_URL.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=
# Embedding model name — BAAI/bge-m3 is a multilingual 1024-dim encoder.
EMBEDDINGS_MODEL=BAAI/bge-m3
# Vector dimensions — must match the pgvector column in models.py.
EMBEDDINGS_DIMENSIONS=1024
# Texts per single API call to /v1/embeddings (batch size for the API).
EMBEDDINGS_BATCH_SIZE=50
# DB rows fetched per backfill iteration. Each iteration makes
# ceil(EMBEDDINGS_BACKFILL_BATCH / EMBEDDINGS_BATCH_SIZE) API calls.
EMBEDDINGS_BACKFILL_BATCH=500
# Max reviews returned when the Semantic search field is used.
SEMANTIC_SEARCH_LIMIT=200
# pgvector HNSW recall at query time (higher = better recall, slightly slower).
SEMANTIC_SEARCH_EF_SEARCH=100
# Cosine distance ceiling; omit or leave empty to disable the similarity floor.
SEMANTIC_SEARCH_MAX_DISTANCE=0.55
